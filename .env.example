# Local preview works with only these two values.
WEBHOOK_SECRET=replace-with-at-least-24-random-characters
LOCAL_DECISIONS=true

# Terraform writes only resource-scoped runtime credentials here for cloud mode.
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_API_KEY=
KAFKA_API_SECRET=
SCHEMA_REGISTRY_URL=
SCHEMA_REGISTRY_API_KEY=
SCHEMA_REGISTRY_API_SECRET=
KAFKA_CONSUMER_GROUP=releaseguard_dashboard_v1
